---

<section id="portfolio" class="pt-8 sm:pt-12 pb-16 sm:pb-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
            <span class="text-xs font-bold text-gold uppercase tracking-widest">Galeri Karya &amp; Hasil Makeup</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-espresso">Portofolio Kategori</h2>
            <p class="text-muted-brown text-sm sm:text-base">Klik pada foto untuk memperbesar karya riasan kami.</p>
        </div>

        <!-- Category Filter Tabs -->
        <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto no-scrollbar pb-4 mb-8">
            <button class="port-tab active-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-espresso text-cream" data-cat="all">Semua Look</button>
            <button class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="bridal">Bridal &amp; Tunangan</button>
            <button class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="graduation">Wisuda &amp; Sekolah</button>
            <button class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="party">Party &amp; Event</button>
        </div>

        <!-- Gallery Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
            {portfolioItems.map(item => (
                <div
                    class="port-item group relative aspect-[3/4] rounded-2xl overflow-hidden shadow-md cursor-pointer"
                    data-category={item.category}
                    data-img={item.img}
                    data-title={item.title}
                >
                    <img
                        src={item.img}
                        alt={item.alt}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-espresso/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end text-white">
                        <span class="text-[10px] uppercase font-bold text-blush tracking-wider">{item.cat_label}</span>
                        <h3 class="font-serif text-lg font-bold">{item.title}</h3>
                        <p class="text-xs text-cream/90">{item.desc}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    // Portfolio filter
    const tabs = document.querySelectorAll<HTMLElement>('.port-tab');
    const items = document.querySelectorAll<HTMLElement>('.port-item');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const cat = tab.dataset.cat!;

            tabs.forEach(t => {
                t.className = 'port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white';
            });
            tab.className = 'port-tab active-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-espresso text-cream';

            items.forEach(item => {
                item.style.display = (cat === 'all' || item.dataset.category === cat) ? 'block' : 'none';
            });
        });
    });

    // Lightbox open on portfolio item click
    items.forEach(item => {
        item.addEventListener('click', () => {
            const img = item.dataset.img!;
            const title = item.dataset.title!;
            window.dispatchEvent(new CustomEvent('openLightbox', { detail: { img, title } }));
        });
    });
</script>
