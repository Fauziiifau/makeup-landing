        category: 'bridal',
        img: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
        alt: 'Engagement Makeup',
        cat_label: 'Bridal & Tunangan',
        title: 'Engagement Look — Soft Rose Glow',
        desc: 'Sentuhan flawless natural anggun untuk lamaran',
    },
    {
        id: 2,
        category: 'graduation',
        img: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=800&auto=format&fit=crop',
        alt: 'Wisuda Makeup',
        cat_label: 'Wisuda & Sekolah',
        title: 'Wisuda Perguruan Tinggi Look',
        desc: 'Ringan, tidak berat di wajah, tahan panas seharian',
    },
    {
        id: 3,
        category: 'party',
        img: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=800&auto=format&fit=crop',
        alt: 'Bridesmaid Makeup',
        cat_label: 'Party & Event',
        title: 'Bridesmaid Look — Nude Glam',
        desc: 'Tampil menawan di pesta & pernikahan sahabat',
    },
    {
        id: 4,
        category: 'bridal',
        img: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?q=80&w=800&auto=format&fit=crop',
        alt: 'Prewedding Makeup',
        cat_label: 'Bridal & Tunangan',
        title: 'Prewedding Photo Makeup',
        desc: 'Riasan HD kamera tahan sorotan lampu studio/outdoor',
    },
    {
        id: 5,
        category: 'graduation',
        img: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800&auto=format&fit=crop',
        alt: 'Graduation SMP SMA',
        cat_label: 'Wisuda & Sekolah',
        title: 'Graduation SMP/SMA Clean Girl',
        desc: 'Makeup natural remaja, tidak berlebihan & tetap manis',
    },
    {
        id: 6,
        category: 'party',
