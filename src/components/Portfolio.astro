---
import makeupEdit1 from "../assets/makeup/makeup_edit1.png";
import makeupEdit2 from "../assets/makeup/makeup_edit2.jpg";
import makeupEdit3 from "../assets/makeup/makeup_edit3.jpg";
import makeupEdit4 from "../assets/makeup/makeup_edit4.jpg";
import makeupEdit5 from "../assets/makeup/makeup_edit5.jpg";
import makeupEdit6 from "../assets/makeup/makeup_edit6.png";
import makeupEdit7 from "../assets/makeup/makeup_edit7.png";
import makeupEdit8 from "../assets/makeup/makeup_edit8.png";
import makeupEdit9 from "../assets/makeup/makeup_edit9.png";

import { featuredVideos, tiktokProfile } from '../data/tiktok';

const featured = featuredVideos.filter(video => /^\d{15,25}$/.test(video.id));
const portfolioItems = [
    {
        id: 1,
        category: 'party',
        img: makeupEdit1.src,
        alt: 'Engagement Makeup',
        cat_label: 'Party & Event',
        title: 'MC & Host Event Look',
        desc: 'Fresh, flawless di kamera, & tahan lama di bawah lampu panggung',
    },
    {
        id: 2,
        category: 'graduation',
        img: makeupEdit2.src,
        alt: 'Wisuda Makeup',
        cat_label: 'Wisuda & Sekolah',
        title: 'Wisuda Perguruan Tinggi Look',
        desc: 'Ringan, tidak berat di wajah, tahan panas seharian',
    },
    {
        id: 3,
        category: 'bridal',
        img: makeupEdit3.src,
        alt: 'Bridesmaid Makeup',
        cat_label: 'Bridal & Tunangan',
        title: 'Bridesmaid Look — Nude Glam',
        desc: 'Tampil menawan di pesta & pernikahan sahabat',
    },
    {
        id: 4,
        category: 'bridal',
        img: makeupEdit6.src,
        alt: 'Prewedding Makeup',
        cat_label: 'Bridal & Tunangan',
        title: 'Prewedding Photo Makeup',
        desc: 'Riasan HD kamera tahan sorotan lampu studio/outdoor',
    },
    {
        id: 5,
        category: 'graduation',
        img: makeupEdit4.src,
        alt: 'Graduation SMP SMA',
        cat_label: 'Wisuda & Sekolah',
        title: 'Graduation SMP/SMA Clean Girl',
        desc: 'Makeup natural remaja, tidak berlebihan & tetap manis',
    },
    {
        id: 6,
        category: 'party',
        img: makeupEdit5.src,
        alt: 'Event Karnaval',
        cat_label: 'Party & Event',
        title: 'Pentas & Karnaval Special Look',
        desc: 'Riasan tegas & berkarakter untuk acara panggung',
    },
    {
        id: 7,
        category: 'bridal',
        img: makeupEdit7.src,
        alt: 'Prewedding Makeup',
        cat_label: 'Bridal & Tunangan',
        title: 'Prewedding Photo Makeup',
        desc: 'Sentuhan makeup flawless untuk mengabadikan momen bahagia',
    },
    {
        id: 8,
        category: 'party',
        img: makeupEdit8.src,
        alt: 'Event Karnaval',
        cat_label: 'Party & Event',
        title: 'Pentas & Karnaval Special Look',
        desc: 'Sentuhan makeup natural elegan yang disesuaikan dengan seragam dan kap profesi Anda',
    },
    {
        id: 9,
        category: 'party',
        img: makeupEdit9.src,
        alt: 'Event Karnaval',
        cat_label: 'Party & Event',
        title: 'Pentas & Karnaval Special Look',
        desc: 'Hasil yang profesional untuk mengawali acara',
    },
];
---
<section id="portfolio" class="pt-8 sm:pt-12 pb-16 sm:pb-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
            <span class="text-xs font-bold text-gold uppercase tracking-widest">Galeri Karya &amp; Hasil Makeup</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-espresso">Portofolio Kategori</h2>
            <p class="text-muted-brown text-sm sm:text-base">Jelajahi foto dan video hasil makeup kami.</p>
        </div>

        <!-- Filter gabungan: foto dan video -->
        <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto no-scrollbar pb-4 mb-8" aria-label="Filter portofolio">
            <button type="button" class="port-tab active-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-espresso text-cream" data-cat="all" aria-pressed="true">Semua Look</button>
            <button type="button" class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="bridal" aria-pressed="false">Bridal &amp; Tunangan</button>
            <button type="button" class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="graduation" aria-pressed="false">Wisuda &amp; Sekolah</button>
            <button type="button" class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="party" aria-pressed="false">Party &amp; Event</button>
            <button type="button" class="port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white" data-cat="video" aria-pressed="false"><i class="fa-brands fa-tiktok mr-1"></i> Video TikTok</button>
        </div>

        <!-- Foto portfolio; klik foto tetap membuka lightbox -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
            {portfolioItems.map(item => (
                <div
                    class="port-item group relative aspect-[3/4] rounded-2xl overflow-hidden shadow-md cursor-pointer"
                    data-category={item.category}
                    data-img={item.img}
                    data-title={item.title}
                >
                    <img
                        src={item.img}
                        alt={item.alt}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-espresso/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end text-white">
                        <span class="text-[10px] uppercase font-bold text-blush tracking-wider">{item.cat_label}</span>
                        <h3 class="font-serif text-lg font-bold">{item.title}</h3>
                        <p class="text-xs text-cream/90">{item.desc}</p>
                    </div>
                </div>
            ))}
        </div>

        <!-- Video terintegrasi, tidak ada section TikTok terpisah -->
        <div id="tiktok" class="mt-14 sm:mt-20" aria-label="Galeri video TikTok">
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-espresso text-center mb-7">Beauty in Motion</h3>

            <!-- Video unggulan + video hasil sinkronisasi dalam grid yang sama -->
            <div id="portfolio-videos" class="flex flex-wrap justify-center gap-5 sm:gap-6" aria-live="polite">
                {featured.map(video => (
                    <article class="w-full max-w-[260px] bg-white rounded-3xl border border-warm-nude overflow-hidden shadow-sm">
                        <div class="aspect-[9/16] bg-espresso relative" data-tiktok-id={video.id}>
                            <button type="button" class="tiktok-play absolute inset-0 w-full h-full text-white flex flex-col items-center justify-center gap-3 bg-gradient-to-t from-espresso to-espresso/70 hover:from-espresso/90" aria-label={`Putar ${video.title}`}>
                                <i class="fa-solid fa-circle-play text-5xl text-gold"></i>
                                <span class="font-semibold text-sm px-4 text-center">Putar video</span>
                            </button>
                        </div>
                        <div class="p-4">
                            <p class="text-sm font-semibold text-espresso line-clamp-2">{video.title}</p>
                            <a href={`${tiktokProfile}/video/${video.id}`} target="_blank" rel="noopener noreferrer" class="inline-block text-xs text-gold hover:underline mt-2">Buka di TikTok</a>
                        </div>
                    </article>
                ))}
            </div>

            <div class="text-center mt-8">
                <a href={tiktokProfile} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-espresso text-cream hover:bg-espresso/90 px-7 py-3.5 rounded-full text-xs font-bold tracking-wide transition-colors">
                    <i class="fa-brands fa-tiktok"></i>
                    Lihat Semua Video di TikTok
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    // Filter foto dan video pada satu section portfolio
    const tabs = document.querySelectorAll<HTMLButtonElement>('#portfolio .port-tab');
    const items = document.querySelectorAll<HTMLElement>('#portfolio .port-item');
    const photoGrid = document.getElementById('portfolio-grid');
    const videoGallery = document.getElementById('tiktok');
    const inactiveTabClass = 'port-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-warm-nude text-espresso hover:bg-gold hover:text-white';
    const activeTabClass = 'port-tab active-tab px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-espresso text-cream';

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const category = tab.dataset.cat ?? 'all';
            tabs.forEach(button => {
                const active = button === tab;
                button.className = active ? activeTabClass : inactiveTabClass;
                button.setAttribute('aria-pressed', String(active));
            });
            if (photoGrid) photoGrid.style.display = category === 'video' ? 'none' : 'grid';
            items.forEach(item => {
                item.style.display = (category === 'all' || item.dataset.category === category) ? '' : 'none';
            });
            if (videoGallery) videoGallery.style.display = (category === 'all' || category === 'video') ? '' : 'none';
        });
    });

    // Foto tetap menggunakan modal lightbox dari app.ts
    items.forEach(item => {
        item.addEventListener('click', () => {
            const img = item.dataset.img!;
            const title = item.dataset.title!;
            window.dispatchEvent(new CustomEvent('openLightbox', { detail: { img, title } }));
        });
    });

    // TikTok iframe hanya dimuat setelah tombol putar diklik
    document.getElementById('tiktok')?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.tiktok-play');
        if (!button) return;
        const frame = button.closest<HTMLElement>('[data-tiktok-id]');
        const id = frame?.dataset.tiktokId;
        if (!frame || !id || !/^\d{15,25}$/.test(id)) return;

        const iframe = document.createElement('iframe');
        iframe.src = `https://www.tiktok.com/player/v1/${id}`;
        iframe.title = 'Video TikTok AULIAAS_MAKEUP';
        iframe.className = 'w-full h-full absolute inset-0';
        iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.replaceChildren(iframe);
    });

    // Sinkronisasi feed dari public/tiktok-latest.json (jika tersedia).
    // Tidak menampilkan pesan status/kosong ketika feed belum tersedia.
    type RecentVideo = { id: string; title?: string };
    const videoContainer = document.getElementById('portfolio-videos');
    const profile = 'https://www.tiktok.com/@auliaas_makeup';
    const featuredIds = new Set(
        Array.from(document.querySelectorAll<HTMLElement>('#portfolio [data-tiktok-id]'))
            .map(node => node.dataset.tiktokId)
    );

    function createVideoCard(video: RecentVideo): HTMLElement {
        const article = document.createElement('article');
        article.className = 'w-full max-w-[260px] bg-white rounded-3xl border border-warm-nude overflow-hidden shadow-sm';
        const frame = document.createElement('div');
        frame.className = 'aspect-[9/16] bg-espresso relative';
        frame.dataset.tiktokId = video.id;
        const play = document.createElement('button');
        play.type = 'button';
        play.className = 'tiktok-play absolute inset-0 w-full h-full text-white flex flex-col items-center justify-center gap-3 bg-gradient-to-t from-espresso to-espresso/70 hover:from-espresso/90';
        play.setAttribute('aria-label', `Putar ${video.title || 'Video TikTok'}`);
        play.innerHTML = '<i class="fa-solid fa-circle-play text-5xl text-gold"></i><span class="font-semibold text-sm px-4 text-center">Putar video</span>';
        frame.append(play);

        const details = document.createElement('div');
        details.className = 'p-4';
        const title = document.createElement('p');
        title.className = 'text-sm font-semibold text-espresso line-clamp-2';
        title.textContent = video.title || 'Video TikTok';
        const link = document.createElement('a');
        link.href = `${profile}/video/${video.id}`;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className = 'inline-block text-xs text-gold hover:underline mt-2';
        link.textContent = 'Buka di TikTok';
        details.append(title, link);
        article.append(frame, details);
        return article;
    }

    async function loadRecentVideos() {
        if (!videoContainer) return;
        try {
            const response = await fetch('/tiktok-latest.json', { cache: 'no-cache' });
            if (!response.ok) return;
            const payload: unknown = await response.json();
            if (!payload || typeof payload !== 'object' || !('videos' in payload)) return;
            const videos: unknown = payload.videos;
            if (!Array.isArray(videos)) return;

            const latest = videos.filter((video): video is RecentVideo =>
                !!video && typeof video === 'object' &&
                typeof video.id === 'string' && /^\d{15,25}$/.test(video.id) &&
                !featuredIds.has(video.id)
            ).slice(0, 6);

            latest.forEach(video => videoContainer.append(createVideoCard(video)));
        } catch {
        }
    }

    loadRecentVideos();
</script>