---
// Pricing.astro — Section #pricing: 9 service pricing cards in a 3x3 grid

interface PricingCard {
    badge: string;
    tag?: string;
    tagStyle?: string;
    title: string;
    price: string;
    features: string[];
    waText: string;
    btnClass: string;
    featured?: boolean;
}

const pricingCards: PricingCard[] = [
    {
        badge: 'Wedding',
        title: 'Akad Wedding Intimate',
        price: 'Rp 400.000',
        features: ['Makeup Only', 'GRATIS pasang bulu mata', 'GRATIS simple hijab do', 'Pasang ACC Simple'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Akad%20Wedding%20Intimate%20(Rp%20400.000)',
        btnClass: 'w-full bg-espresso hover:bg-gold text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-sm btn-touch',
    },
    {
        badge: 'Engagement',
        featured: true,
        title: 'Tunangan (Engagement)',
        price: 'Rp 250.000',
        features: ['Soft Glam Elegant Finish', 'GRATIS pasang bulu mata', 'GRATIS simple hijab do'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Tunangan%20(Rp%20250.000)',
        btnClass: 'w-full bg-gold hover:bg-gold-hover text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-gold-glow btn-touch',
    },
    {
        badge: 'Photoshoot',
        title: 'Prewedding',
        price: 'Rp 200.000',
        features: ['GRATIS pasang bulu mata', 'GRATIS simple hijab do'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Prewedding%20(Rp%20200.000)',
        btnClass: 'w-full bg-espresso hover:bg-gold text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-sm btn-touch',
    },
    {
        badge: 'Wedding Party',
        title: 'Bridesmaid',
        price: 'Rp 150.000',
        features: ['GRATIS pasang bulu mata', 'Penyesuaian tema kostum'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Bridesmaid%20(Rp%20150.000)',
        btnClass: 'w-full bg-espresso hover:bg-gold text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-sm btn-touch',
    },
    {
        badge: 'Graduation',
        title: 'Wisuda Perguruan Tinggi',
        price: 'Rp 170.000',
        features: ['GRATIS pasang bulu mata', 'GRATIS simple hijab do'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Wisuda%20Perguruan%20Tinggi%20(Rp%20170.000)',
        btnClass: 'w-full bg-espresso hover:bg-gold text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-sm btn-touch',
    },
    {
        badge: 'Family Bridal',
        title: 'Mom / Sister Brides',
        price: 'Rp 150.000',
        features: ['GRATIS pasang bulu mata', 'GRATIS simple hijab do'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Mom%20%2F%20Sister%20Brides%20(Rp%20150.000)',
        btnClass: 'w-full bg-espresso hover:bg-gold text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-sm btn-touch',
    },
    {
        badge: 'Wedding Party',
        title: 'Kondangan',
        price: 'Rp 120.000',
        features: ['Soft Flawless Look', 'GRATIS pasang bulu mata', 'GRATIS simple hijab do'],
        waText: 'Halo%20AULIAAS_MAKEUP,%20saya%20tertarik%20booking%20layanan%20Kondangan%20(Rp%20120.000)',
        btnClass: 'w-full bg-espresso hover:bg-gold text-white text-center py-3 rounded-2xl text-xs font-semibold block transition-colors shadow-sm btn-touch',
    },
];
---

<section id="pricing" class="pt-8 sm:pt-12 pb-16 sm:pb-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
            <span class="text-xs font-bold text-gold uppercase tracking-widest">List Rate Card</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-espresso">Daftar Paket Harga Services</h2>
        </div>

        <!-- 3x3 Responsive Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {pricingCards.map((card, index) => (
                <div
                    class={`luxury-card rounded-3xl p-6 sm:p-7 flex flex-col justify-between
                    ${card.featured ? ' ring-2 ring-gold/50' : ''}
                    ${
                        index === pricingCards.length - 1
                            ? 'md:col-span-2 md:w-[calc(50%-1rem)] md:justify-self-center lg:col-span-1 lg:w-full lg:col-start-2'
                            : ''
                    }`}>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full bg-warm-nude text-espresso text-[10px] font-bold uppercase tracking-wider">{card.badge}</span>
                            {card.tag && <span class={card.tagStyle}>{card.tag}</span>}
                            {card.featured && <span class="text-xs font-semibold text-gold">★ Best Seller</span>}
                        </div>
                        <div>
                            <h3 class="font-serif text-xl font-bold text-espresso">{card.title}</h3>
                        </div>
                        <div class="pt-2 border-t border-warm-nude">
                            <div class="font-serif text-2xl font-bold text-espresso">{card.price} <span class="text-xs font-sans font-normal text-muted-brown">/ pax</span></div>
                        </div>
                        <ul class="text-xs text-espresso/90 space-y-2 pt-2">
                            {card.features.map(f => (
                                <li class="flex items-center gap-2">
                                    <i class="fa-solid fa-check text-gold text-xs"></i>
                                    {f}
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div class="mt-6 pt-4">
                        <a
                            href="#contact"
                            data-service={card.title}
                            data-price={card.price}
                            class={`pricing-book-btn ${card.btnClass}`}
                        >
                            Pesan Paket Ini
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLAnchorElement>('.pricing-book-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const serviceName = btn.dataset.service?.toLowerCase() || '';
            const price = btn.dataset.price || '';
            const waService = document.getElementById('wa-form-service') as HTMLSelectElement | null;
            if (waService) {
                const numericPrice = price.replace(/[^0-9]/g, '');
                for (let i = 0; i < waService.options.length; i++) {
                    const optText = waService.options[i].text.toLowerCase();
                    const optVal = waService.options[i].value.toLowerCase();
                    if (
                        (numericPrice && optVal.includes(numericPrice)) ||
                        optText.includes(serviceName.split(' ')[0]) ||
                        optVal.includes(serviceName.split(' ')[0])
                    ) {
                        waService.selectedIndex = i;
                        break;
                    }
                }
            }
            setTimeout(() => {
                (document.getElementById('wa-form-name') as HTMLInputElement)?.focus();
            }, 500);
        });
    });
</script>
