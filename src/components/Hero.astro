---
import makeupEdit1 from "../assets/makeup/makeup_edit1.png";

// Hero.astro — Section #about: Editorial hero with image, CTAs, 3D Flip Card, and stat badges
---

<section
    id="about"
    class="pt-24 sm:pt-32 pb-16 sm:pb-24 bg-gradient-to-b from-cream via-warm-nude/30 to-cream relative overflow-hidden"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center"
        >
            <!-- Left Editorial Text Content -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <div
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-warm-nude border border-gold/40 text-[11px] sm:text-xs font-semibold text-gold tracking-wide uppercase"
                >
                    <i class="fa-solid fa-sparkles text-[10px]"></i>
                    <span>Temukan Kebutuhanmu di sini.</span>
                </div>

                <h1
                    class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-espresso leading-tight sm:leading-tight"
                >
                    Enhancing Your <span class="italic text-gold font-normal"
                        >Natural Elegance</span
                    >
                </h1>

                <p
                    class="text-sm sm:text-base text-muted-brown max-w-xl mx-auto lg:mx-0 leading-relaxed"
                >
                    Layanan Rias Pengantin, Wisuda, Pertunangan &amp; Acara
                    Spesial dengan sentuhan makeup yang halus, tahan lama, serta
                    memancarkan kecantikan alami Anda.
                </p>

                <!-- CTAs -->
                <div
                    class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2"
                >
                    <a
                        href="#pricing"
                        class="w-full sm:w-auto bg-espresso hover:bg-espresso/90 text-cream px-7 py-3.5 rounded-full text-xs font-semibold tracking-wider uppercase text-center shadow-lg transition-all btn-touch flex items-center justify-center gap-2"
                    >
                        <span>Lihat Price List Lengkap</span>
                        <i class="fa-solid fa-arrow-down text-xs"></i>
                    </a>
                    <button
                        id="hero-calc-btn"
                        class="w-full sm:w-auto bg-white hover:bg-warm-nude text-espresso border border-warm-nude px-7 py-3.5 rounded-full text-xs font-semibold tracking-wider uppercase text-center shadow-sm transition-all btn-touch flex items-center justify-center gap-2"
                    >
                        <i class="fa-solid fa-calculator text-gold"></i>
                        <span>Kalkulator &amp; Booking</span>
                    </button>
                </div>

                <!-- Highlight Badges -->
                <div
                    class="grid grid-cols-3 gap-3 pt-6 max-w-lg mx-auto lg:mx-0 border-t border-warm-nude"
                >
                    <div class="text-center lg:text-left">
                        <div
                            class="font-serif text-xl sm:text-2xl font-bold text-espresso"
                        >
                            100+
                        </div>
                        <div class="text-[11px] text-muted-brown">
                            Klien Puas
                        </div>
                    </div>
                    <div class="text-center lg:text-left">
                        <div
                            class="font-serif text-xl sm:text-2xl font-bold text-espresso"
                        >
                            4.9/5
                        </div>
                        <div class="text-[11px] text-muted-brown">
                            Rating Ulasan
                        </div>
                    </div>
                    <div class="text-center lg:text-left">
                        <div
                            class="font-serif text-xl sm:text-2xl font-bold text-espresso"
                        >
                            Citra Raya
                        </div>
                        <div class="text-[11px] text-muted-brown">
                            Free Ongkir (Maks. 3 km)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Visual 3D Flip Card Frame -->
            <div class="lg:col-span-5 flex justify-center relative select-none">
                <!-- 3D Perspective Flip Card -->
                <div
                    id="hero-flip-card"
                    class="group relative w-full max-w-md aspect-[4/5] [perspective:1200px] cursor-pointer"
                    role="region"
                    aria-label="AULIAAS_MAKEUP Feature Card"
                >
                    <!-- Card Inner Wrapper -->
                    <div
                        id="hero-flip-inner"
                        class="relative w-full h-full duration-700 [transform-style:preserve-3d] transition-transform rounded-3xl shadow-2xl"
                    >
                        <!-- FRONT FACE: Signature Look & Portfolio Visual -->
                        <div
                            class="absolute inset-0 w-full h-full rounded-3xl overflow-hidden border-4 border-white [backface-visibility:hidden] [transform:rotateY(0deg)] bg-espresso shadow-xl"
                        >
                            <img
                                src={makeupEdit1.src}
                                alt="AULIAAS_MAKEUP Portfolio Feature"
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-espresso/85 via-espresso/25 to-transparent"
                            >
                            </div>

                            <!-- Front Top Flip Action Hint -->
                            <div class="absolute top-4 right-4 z-10">
                                <button
                                    type="button"
                                    id="flip-to-back-btn"
                                    class="bg-white/95 backdrop-blur-md hover:bg-gold hover:text-white text-espresso px-3.5 py-1.5 rounded-full text-[11px] font-semibold tracking-wide flex items-center gap-1.5 shadow-lg border border-gold/30 transition-all btn-touch"
                                    title="Klik untuk melihat keunggulan layanan"
                                >
                                    <i
                                        class="fa-solid fa-rotate text-gold text-xs transition-transform group-hover:rotate-180"
                                    ></i>
                                    <span>Kenapa Kami?</span>
                                </button>
                            </div>

                            <!-- Front Bottom Label -->
                            <div
                                class="absolute bottom-6 left-6 right-6 text-white space-y-1 z-10"
                            >
                                <div class="flex items-center gap-2">
                                    <span
                                        class="text-[11px] uppercase tracking-widest text-blush font-semibold"
                                        >Signature Look</span
                                    >
                                    <span
                                        class="px-2 py-0.5 rounded-full bg-gold/90 text-white text-[9px] font-bold"
                                        >★ Top Rated</span
                                    >
                                </div>
                                <div
                                    class="font-serif text-xl sm:text-2xl font-bold"
                                >
                                    Soft Flawless Glam
                                </div>
                                <div
                                    class="text-[11px] text-warm-nude/90 flex items-center gap-1.5 pt-1"
                                >
                                    <i
                                        class="fa-solid fa-hand-pointer text-gold text-[10px] animate-bounce"
                                    ></i>
                                    <span
                                        >Klik / Sentuh untuk melihat info
                                        keunggulan</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- BACK FACE: Luxury Perks & Direct Reservation CTA -->
                        <div
                            class="absolute inset-0 w-full h-full rounded-3xl overflow-hidden border-4 border-gold/40 [backface-visibility:hidden] [transform:rotateY(180deg)] bg-gradient-to-br from-espresso via-[#382b26] to-espresso text-white p-6 sm:p-7 flex flex-col justify-between shadow-2xl"
                        >
                            <div class="space-y-3.5">
                                <div
                                    class="flex items-center justify-between border-b border-gold/30 pb-3"
                                >
                                    <div class="flex items-center gap-2.5">
                                        <div
                                            class="w-8 h-8 rounded-full bg-gold/20 flex items-center justify-center text-gold"
                                        >
                                            <i class="fa-solid fa-crown text-sm"
                                            ></i>
                                        </div>
                                        <div>
                                            <span
                                                class="text-[10px] text-gold uppercase tracking-wider font-bold"
                                                >Exclusive Perks</span
                                            >
                                            <h3
                                                class="font-serif text-lg font-bold text-cream"
                                            >
                                                Keunggulan Layanan
                                            </h3>
                                        </div>
                                    </div>
                                    <button
                                        type="button"
                                        id="flip-to-front-btn"
                                        class="text-warm-nude/80 hover:text-gold p-1.5 text-xs flex items-center gap-1 bg-white/10 hover:bg-white/20 rounded-full px-2.5 transition-colors"
                                    >
                                        <i class="fa-solid fa-rotate"></i>
                                        <span>Foto</span>
                                    </button>
                                </div>

                                <!-- Highlights List -->
                                <div class="space-y-2.5 text-xs">
                                    <div
                                        class="flex items-start gap-3 p-2.5 rounded-2xl bg-white/5 border border-white/10 hover:border-gold/40 transition-colors"
                                    >
                                        <div
                                            class="w-7 h-7 rounded-xl bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5"
                                        >
                                            <i
                                                class="fa-solid fa-wand-magic-sparkles text-xs"
                                            ></i>
                                        </div>
                                        <div>
                                            <div
                                                class="font-semibold text-cream text-[13px]"
                                            >
                                                Flawless &amp; Long Lasting
                                            </div>
                                            <div
                                                class="text-[11px] text-warm-nude/70"
                                            >
                                                Formula tahan lebih dari 12 jam,
                                                anti-crack &amp; waterproof.
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="flex items-start gap-3 p-2.5 rounded-2xl bg-white/5 border border-white/10 hover:border-gold/40 transition-colors"
                                    >
                                        <div
                                            class="w-7 h-7 rounded-xl bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5"
                                        >
                                            <i class="fa-solid fa-gift text-xs"
                                            ></i>
                                        </div>
                                        <div>
                                            <div
                                                class="font-semibold text-cream text-[13px]"
                                            >
                                                Free Bulu Mata &amp; Hijab Do
                                            </div>
                                            <div
                                                class="text-[11px] text-warm-nude/70"
                                            >
                                                Gratis pasang bulu mata &amp;
                                                hijab simpel di semua paket.
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="flex items-start gap-3 p-2.5 rounded-2xl bg-white/5 border border-white/10 hover:border-gold/40 transition-colors"
                                    >
                                        <div
                                            class="w-7 h-7 rounded-xl bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5"
                                        >
                                            <i
                                                class="fa-solid fa-truck-fast text-xs"
                                            ></i>
                                        </div>
                                        <div>
                                            <div
                                                class="font-semibold text-cream text-[13px]"
                                            >
                                                Free Transport Citra Raya
                                            </div>
                                            <div
                                                class="text-[11px] text-warm-nude/70"
                                            >
                                                Gratis maks. 3 km. Luar area
                                                hanya Rp 20.000 / 3 km.
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="flex items-start gap-3 p-2.5 rounded-2xl bg-white/5 border border-white/10 hover:border-gold/40 transition-colors"
                                    >
                                        <div
                                            class="w-7 h-7 rounded-xl bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5"
                                        >
                                            <i
                                                class="fa-solid fa-shield-heart text-xs"
                                            ></i>
                                        </div>
                                        <div>
                                            <div
                                                class="font-semibold text-cream text-[13px]"
                                            >
                                                Higienis &amp; Aman Kulit
                                            </div>
                                            <div
                                                class="text-[11px] text-warm-nude/70"
                                            >
                                                Peralatan steril, brush bersih
                                                &amp; kosmetik terpercaya.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Back Action -->
                            <div class="pt-2 border-t border-gold/30">
                                <a
                                    href="#contact"
                                    id="back-consult-btn"
                                    class="w-full bg-gold hover:bg-gold-hover text-white py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-center shadow-gold-glow flex items-center justify-center gap-2 btn-touch transition-all"
                                >
                                    <i class="fa-solid fa-calendar-check"></i>
                                    <span>Konsultasi &amp; Reservasi</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Badge -->
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* 3D Flip Card Styles */
    #hero-flip-card.is-flipped #hero-flip-inner {
        transform: rotateY(180deg);
    }

    @media (hover: hover) and (pointer: fine) {
        #hero-flip-card:hover #hero-flip-inner {
            transform: rotateY(180deg);
        }
        #hero-flip-card.is-flipped:hover #hero-flip-inner {
            transform: rotateY(0deg);
        }
    }
</style>

<script>
    // Calculator button trigger
    document.getElementById("hero-calc-btn")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("openCalcModal"));
    });

    // Flip Card Click / Tap Handlers
    const flipCard = document.getElementById("hero-flip-card");
    const flipToBackBtn = document.getElementById("flip-to-back-btn");
    const flipToFrontBtn = document.getElementById("flip-to-front-btn");
    const backConsultBtn = document.getElementById("back-consult-btn");

    flipToBackBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        flipCard?.classList.add("is-flipped");
    });

    flipToFrontBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        flipCard?.classList.remove("is-flipped");
    });

    backConsultBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        // Allow link navigation to #contact
    });

    flipCard?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("#back-consult-btn") || target.closest("a")) return;
        flipCard?.classList.toggle("is-flipped");
    });
</script>