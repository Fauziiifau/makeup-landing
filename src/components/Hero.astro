---
// Hero.astro — Section #about: Editorial hero with image, CTAs, and stat badges
---

<section id="about"
    class="pt-24 sm:pt-32 pb-16 sm:pb-24 bg-gradient-to-b from-cream via-warm-nude/30 to-cream relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

            <!-- Left Editorial Text Content -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <div
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-warm-nude border border-gold/40 text-[11px] sm:text-xs font-semibold text-gold tracking-wide uppercase">
                    <i class="fa-solid fa-sparkles text-[10px]"></i>
                    <span>Official Beauty &amp; Bridal Rate Card 2026</span>
                </div>

                <h1
                    class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-espresso leading-tight sm:leading-tight">
                    Enhancing Your <span class="italic text-gold font-normal">Natural Elegance</span>
                </h1>

                <p class="text-sm sm:text-base text-muted-brown max-w-xl mx-auto lg:mx-0 leading-relaxed">
                    Layanan Rias Pengantin, Wisuda, Pertunangan &amp; Acara Spesial dengan sentuhan makeup yang
                    halus, tahan lama, serta menonjolkan kecantikan alami Anda secara maksimal.
                </p>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
                    <a href="#pricing"
                        class="w-full sm:w-auto bg-espresso hover:bg-espresso/90 text-cream px-7 py-3.5 rounded-full text-xs font-semibold tracking-wider uppercase text-center shadow-lg transition-all btn-touch flex items-center justify-center gap-2">
                        <span>Lihat Price List Lengkap</span>
                        <i class="fa-solid fa-arrow-down text-xs"></i>
                    </a>
                    <button id="hero-calc-btn"
                        class="w-full sm:w-auto bg-white hover:bg-warm-nude text-espresso border border-warm-nude px-7 py-3.5 rounded-full text-xs font-semibold tracking-wider uppercase text-center shadow-sm transition-all btn-touch flex items-center justify-center gap-2">
                        <i class="fa-solid fa-calculator text-gold"></i>
                        <span>Kalkulator &amp; Booking</span>
                    </button>
                </div>

                <!-- Highlight Badges -->
                <div class="grid grid-cols-3 gap-3 pt-6 max-w-lg mx-auto lg:mx-0 border-t border-warm-nude">
                    <div class="text-center lg:text-left">
                        <div class="font-serif text-xl sm:text-2xl font-bold text-espresso">500+</div>
                        <div class="text-[11px] text-muted-brown">Klien Puas</div>
                    </div>
                    <div class="text-center lg:text-left">
                        <div class="font-serif text-xl sm:text-2xl font-bold text-espresso">4.9/5</div>
                        <div class="text-[11px] text-muted-brown">Rating Ulasan</div>
                    </div>
                    <div class="text-center lg:text-left">
                        <div class="font-serif text-xl sm:text-2xl font-bold text-espresso">Citra Raya</div>
                        <div class="text-[11px] text-muted-brown">Free Ongkir Transport</div>
                    </div>
                </div>
            </div>

            <!-- Right Visual Image Frame -->
            <div class="lg:col-span-5 flex justify-center relative">
                <div
                    class="relative w-full max-w-md aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
                    <img src="https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?q=80&w=800&auto=format&fit=crop"
                        alt="AULIAAS_MAKEUP Portfolio Feature" class="w-full h-full object-cover">
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-espresso/60 via-transparent to-transparent">
                    </div>
                    <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
                        <div class="text-[11px] uppercase tracking-widest text-blush font-semibold">Signature
                            Look</div>
                        <div class="font-serif text-lg font-bold">Soft Flawless Glam</div>
                    </div>
                </div>

                <!-- Floating Badge -->
                <div
                    class="absolute top-6 left-2 sm:-left-6 bg-white/95 backdrop-blur-md p-3.5 rounded-2xl shadow-xl border border-warm-nude flex items-center gap-3">
                    <div
                        class="w-9 h-9 rounded-full bg-blush/30 text-espresso flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-wand-magic-sparkles text-gold"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-espresso">Gratis Pasang Bulu Mata</div>
                        <div class="text-[10px] text-muted-brown">&amp; Simple Hijab Do di Semua Paket</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    document.getElementById('hero-calc-btn')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openCalcModal'));
    });
</script>
