---
import '../styles/global.css';

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'AULIAAS_MAKEUP — Professional Beauty & Bridal Makeup Artist',
    description = 'Jasa MUA & Rias Pengantin Profesional di Citra Raya & Sekitarnya. Layanan Rias Wisuda, Prewedding, Tunangan, Party & Event.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="antialiased selection:bg-blush selection:text-espresso pb-16 sm:pb-0">
    <div class="w-full overflow-x-hidden min-h-screen relative">
        <slot />
    </div>
</body>

</html>
